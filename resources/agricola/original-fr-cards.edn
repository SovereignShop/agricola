;; Original France (FR / G3), native batches.
{:catalog/original-expansion-fr-3-amusement-park
 {:play [{:op :schedule :offset-count [:min 5 [:+ [:pastures] 1]] :goods {:food 1}}]}
 :catalog/original-expansion-fr-10-breakfast-outdoors
 {:cost-options [{:vegetable 1} {:grain 2}]
  :triggers [{:event :feeding-start :effect {:op :gain :goods {:food 1}}}]}
 :catalog/original-expansion-fr-16-cornrick
 {:play [{:op :schedule :rounds [7 9] :goods {:grain 1}}]}
 :catalog/original-expansion-fr-17-diary
 {:triggers [{:event :occupation :effect {:op :gain :goods {:wood 1}}}]}
 :catalog/original-expansion-fr-38-orchard
 {:play [{:op :schedule :offset-count [:planted-farm-fields] :goods {:food 1}}]}
 :catalog/original-expansion-fr-39-par-force-hunting
 {:play [{:op :schedule :offsets [4 7] :effect {:op :gain :goods {:boar 1} :cost {:food 1} :optional? true}}]}
 :catalog/original-expansion-fr-43-sofa
 {:score {:type :expression :value [:if [:<= [:rooms] 2] 4 [:if [:= [:rooms] 3] 2 0]]}}
 :catalog/original-expansion-fr-44-star-classification-meal
 {:requires [:= [:house] :stone]
  :play [{:op :schedule :offset-count [:rounds-left] :goods {:food 1}}]}
 :catalog/original-expansion-fr-48-swimming-studio
 {:triggers [{:event :use-space :spaces #{:fishing}
              :effect {:op :exchange :cost {:wood 1} :goods {:food 3} :optional? true}}]}
 :catalog/original-expansion-fr-53-trip-to-the-lake
 {:triggers [{:event :use-space :spaces #{:fishing} :effect {:op :gain :goods {:food 1 :wood 1}}}]}
 :catalog/original-expansion-fr-57-wild-game
 {:play [{:op :gain :goods {:food 5}}]}
 :catalog/original-expansion-fr-100-pipe-smoker
 {:triggers [{:event :before-field-phase
              :condition [:test [:and [:not [:= [:context :manure?] true]] [:> [:grain-fields] 0]]]
              :effect {:op :gain :goods {:wood 2}}}]}
 :catalog/original-expansion-fr-22-full-bottomed-wig
 {:passive {:no-renovation-reed true}}
 :catalog/original-expansion-fr-28-hammock
 {:passive {:extra-room 1}}
 :catalog/original-expansion-fr-30-haystack
 {:play [{:op :schedule :offset-count [:rounds-left] :goods {:food 3}}]}
 :catalog/original-expansion-fr-55-vegetable-harvest
 {:passive {:oven-cooking {:vegetable 4}}}
 :catalog/original-expansion-fr-84-grain-speculator
 {:play [{:op :schedule :offsets [1 3 5] :goods {:grain 1}}]}
 :catalog/original-expansion-fr-104-racing-stable-manager
 {:triggers [{:event :stables-created :effect {:op :plow :cost {:food 1} :optional? true}}]}
 :catalog/original-expansion-fr-108-shovel-worker
 {:triggers [{:event :field-phase :condition [:test [:not [:= [:context :manure?] true]]]
              :effect {:op :gain :goods {:food [:max 0 [:- [:pastures] 1]]}}}]}
 :catalog/original-expansion-fr-111-the-sun-farmer
 {:triggers [{:event :use-space :spaces #{:grain} :effect {:op :gain :goods {:sheep 1}}}
             {:event :use-space :spaces #{:sheep} :effect {:op :gain :goods {:grain 1}}}]}

 :catalog/original-expansion-fr-7-baguette
 {:triggers [{:event :feeding-start :condition [:test [:> [:baking-improvements] 0]]
              :effect {:op :bake :cost {:wood 1} :optional? true}}]}
 :catalog/original-expansion-fr-8-barber-shop
 {:play [{:op :points :amount [:remaining-harvests]}]}
 :catalog/original-expansion-fr-32-homework
 {:play [{:op :card-action :kinds #{:occupation} :occupation-cost 0 :optional? true}
         {:op :card-action :kinds #{:occupation} :occupation-cost 0 :optional? true}]}
 :catalog/original-expansion-fr-113-trailblazer
 {:triggers [{:event :round-start :condition [:test [:= [:empty-farm-fields] 0]]
              :effect {:op :plow :cost {:food 1} :optional? true}}]}
 :catalog/original-expansion-fr-18-encircling-wall
 {:play [{:op :mini-pasture :optional? true}]}
 :catalog/original-expansion-fr-45-stone-house-reconstruction
 {:ability {:op :renovate-clay-stone}}
 :catalog/original-expansion-fr-1-abandoned-willow
 {:requires [:>= [:empty-farm-fields] 1] :requires-effect? true
  :play [{:op :remove-empty-field :goods {:wood 4}}]}
 :catalog/original-expansion-fr-101-powerhouse
 {:passive {:before-work-abilities [:< [:goods :stone] 5]}
  :triggers [{:event :work-start :condition [:test [:>= [:goods :stone] 3]]
              :effect {:op :gain :goods {:food [:if [:>= [:goods :stone] 5] 2 1]}}}]}

 :catalog/original-expansion-fr-71-child-care-worker
 {:triggers [{:event :grow :scope :others
              :effect {:op :choose :optional? true
                       :options [{:label "Wood → 2 Food" :cost {:wood 1} :effects [{:op :gain :goods {:food 2}}]}
                                 {:label "Wood + Reed → 5 Food" :cost {:wood 1 :reed 1} :effects [{:op :gain :goods {:food 5}}]}]}}]}
 :catalog/original-expansion-fr-96-oceanographer
 {:play [{:op :stock :goods [:vegetable :stone :grain :clay :wood]}]
  :triggers [{:event :plow :condition [:test [:= [:context :fields-plowed] 1]]
              :effect {:op :take-stock :optional? true}}]}

 :catalog/original-expansion-fr-11-brickyard
 {:triggers [{:event :round-start :condition [:test [:= [:goods :clay] 0]]
              :effect {:op :store-goods :goods {:clay 1}}}]
  :ability {:op :release-stored :minimum-stored 4}}
 :catalog/original-expansion-fr-88-journeyman
 {:triggers [{:event :round-start :condition [:house :stone]
              :effect {:op :choose :optional? true
                       :options [{:label "Food → Sheep" :cost {:food 1} :effects [{:op :gain :goods {:sheep 1}}]}
                                 {:label "Food → Wild boar" :cost {:food 1} :effects [{:op :gain :goods {:boar 1}}]}
                                 {:label "Food → Cattle" :cost {:food 1} :effects [{:op :gain :goods {:cattle 1}}]}]}}]}

 :catalog/original-expansion-fr-12-camembert
 {:play [{:op :place-space-goods :count 3 :goods {:food 1}}]}
 :catalog/original-expansion-fr-15-coffee-break
 {:play [{:op :schedule :offsets [1 2 3 4 5] :goods {:food 1}}]
  :triggers [{:event :occupation :effect {:op :cancel-schedule}}]}

}
