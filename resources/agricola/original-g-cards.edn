;; Original Gamers' deck, native batches. English faces and compendium
;; references are recorded in the art manifest and rules/source ledger.
{:catalog/original-expansion-g-5-architect
 {:triggers [{:event :build-rooms :effect {:op :gain :goods {:food [:* 2 [:context :rooms-built]]}}}
             {:event :stables-created :effect {:op :gain :goods {:food [:context :stables-built]}}}]}
 :catalog/original-expansion-g-10-bard
 {:triggers [{:event :use-space :scope :others :spaces #{:traveling}
              :effect {:op :gain :goods {:food 1 :wood 1}}}]}
 :catalog/original-expansion-g-21-hermit
 {:score {:type :expression :value [:if [:= [:occupations] 1] 6 0]}}
 :catalog/original-expansion-g-29-harbor-master
 {:triggers [{:event :use-space :spaces #{:fishing} :effect {:op :gain :goods {:reed 1}}}
             {:event :use-space :scope :others :spaces #{:fishing} :effect {:op :gain :goods {:reed 1 :food 1}}}]}
 :catalog/original-expansion-g-51-stone-deliveryman
 {:play [{:op :schedule :rounds [8 10 12 14] :goods {:stone 1}}]}
 :catalog/original-expansion-g-69-clear-cutting
 {:triggers [{:event :plow :effect {:op :gain :goods {:wood [:context :fields-plowed]}}}]}
 :catalog/original-expansion-g-75-farmers-market
 {:play [{:op :gain :goods {:vegetable 1}}]}
 :catalog/original-expansion-g-81-hayloft
 {:score {:type :expression :value [:min 2 [:max 0 [:- [:stables] 2]]]}}
 :catalog/original-expansion-g-87-magic-beans
 {:play [{:op :gain :goods {:vegetable 2}}]}
 :catalog/original-expansion-g-93-plentiful-fields
 {:play [{:op :gain :goods {:food [:planted-farm-fields]}}]}
 :catalog/original-expansion-g-33-hoe-maker
 {:triggers [{:event :fence :effect {:op :plow :cost {:food 1} :optional? true}}]}
 :catalog/original-expansion-g-49-seed-master
 {:ability {:op :exchange-options :options [{:label "1 grain + 1 food → 1 vegetable" :cost {:grain 1 :food 1} :goods {:vegetable 1}}
                                           {:label "1 vegetable → 1 grain" :cost {:vegetable 1} :goods {:grain 1}}]}}
 :catalog/original-expansion-g-73-errant-oven
 {:passive {:oven true} :play [{:op :bake :optional? true}]}
 :catalog/original-expansion-g-74-extra-effort
 {:printed-cost {:food 1} :cost-text "1 Food"
  :requires-effect? true :play [{:op :card-action :kinds #{:major}}]}
 :catalog/original-expansion-g-86-itinerant-laborers
 {:play [{:op :sow-offer :optional? true}]}
 :catalog/original-expansion-g-89-migrant-workers
 {:triggers [{:event :use-space :spaces #{:labor} :effect {:op :plow :cost {:food 1} :optional? true}}]}
 :catalog/original-expansion-g-99-reed-beds
 {:triggers [{:event :use-space :spaces #{:plow} :effect {:op :gain :goods {:reed 1}}}]}
 :catalog/original-expansion-g-113-stone-kitchen
 {:passive {:cook {:vegetable 4 :sheep 2 :boar 3 :cattle 4} :bake 3 :crock-compatible true}}

 :catalog/original-expansion-g-25-businesswoman
 {:play [{:op :card-action :kinds #{:major :minor} :optional? true}
         {:op :card-action :kinds #{:major :minor} :optional? true}]}
 :catalog/original-expansion-g-50-singer
 {:play [{:op :choose-good :choices [:wood :clay :reed :stone]}
         {:op :choose-good :choices [:wood :clay :reed :stone]}]}
 :catalog/original-expansion-g-76-gardening-tools
 {:triggers [{:event :sow :scope :others :effect {:op :sow-offer :cost {:food 1} :optional? true}}]}
 :catalog/original-expansion-g-110-shovel
 {:triggers [{:event :use-space :spaces #{:labor} :effect {:op :sow-offer :optional? true}}]}
 :catalog/original-expansion-g-105-seed-spreader
 {:triggers [{:event :use-space :spaces #{:plow}
              :effect {:op :sow-offer :max-fields 1 :allowed-crops #{:grain :vegetable} :optional? true}}]}
 :catalog/original-expansion-g-117-vegetable-scoop
 {:triggers [{:event :use-space :spaces #{:vegetable} :effect {:op :gain :goods {:vegetable 1}}}]}
 :catalog/original-expansion-g-107-sheep-market
 {:triggers [{:event :before-field-phase :condition [:test [:and [:not [:= [:context :manure?] true]] [:> [:+ [:goods :grain] [:goods :vegetable] [:goods :sheep]] 0]]]
              :effect {:op :choose :optional? true
                       :options [{:label "Grain → Sheep" :cost {:grain 1} :effects [{:op :gain :goods {:sheep 1}}]}
                                 {:label "Vegetable → Sheep" :cost {:vegetable 1} :effects [{:op :gain :goods {:sheep 1}}]}
                                 {:label "Sheep → Grain" :cost {:sheep 1} :effects [{:op :gain :goods {:grain 1}}]}
                                 {:label "Sheep → Vegetable" :cost {:sheep 1} :effects [{:op :gain :goods {:vegetable 1}}]}]}}]}
 :catalog/original-expansion-g-119-wooden-bridge
 {:triggers [{:event :use-space :spaces #{:reed} :effect {:op :gain :goods {:food 1}}}
             {:event :use-space :spaces #{:labor} :effect {:op :gain :goods {:reed 1}}}]}

}
