;; Original World Championship (WM / G2), native batches.
{:catalog/original-expansion-wm-3-apple-picker
 {:triggers [{:event :use-space :spaces #{:grain :vegetable} :effect {:op :gain :goods {:wood 1 :food 1}}}]}
 :catalog/original-expansion-wm-67-buried-treasure
 {:triggers [{:event :use-space :spaces #{:plow :cultivation} :effect {:op :gain :goods {:stone 1}}}]}
 :catalog/original-expansion-wm-76-drained-pond
 {:play [{:op :schedule :offsets [4] :effect {:op :plow :cost {:food 1} :optional? true}}]}
 :catalog/original-expansion-wm-82-flower-pots
 {:play [{:op :conditional :condition [:test [:<= [:round] 6]]
          :effect {:op :schedule :rounds [8] :goods {:vegetable 1}}}]}
 :catalog/original-expansion-wm-95-mountain-cave
 {:triggers [{:event :feeding-start :effect {:op :exchange :cost {:wood 1} :goods {:stone 1} :optional? true}}]}
 :catalog/original-expansion-wm-97-open-gate
 {:triggers [{:event :feeding-start :effect {:op :points :cost {:sheep 1} :amount 1 :optional? true}}]}
 :catalog/original-expansion-wm-98-petting-zoo
 {:score {:type :expression :value [:if [:= [:animal-types] 3]
                                  [:+ [:if [:>= [:goods :sheep] 2] 1 0] [:if [:>= [:goods :boar] 2] 1 0]] 0]}}
 :catalog/original-expansion-wm-100-plum-patch
 {:requires [:and [:>= [:grain-fields] 1] [:>= [:vegetable-fields] 1]]
  :play [{:op :schedule :offset-count [:planted-farm-fields] :goods {:food 1}}]}
 :catalog/original-expansion-wm-109-steel-plow
 {:passive {:action-plow {:extra-fields 3}} :play [{:op :set-uses :uses 1}]}
 :catalog/original-expansion-wm-111-undisturbed-pond
 {:requires [:= [:occupations] 0]
  :play [{:op :schedule :offset-count [:- [:round] 1] :goods {:food 1}}]}
 :catalog/original-expansion-wm-26-hedge-master
 {:play [{:op :build-fences :optional? true}]
  :triggers [{:event :fence :effect {:op :points :amount 1}}]}
 :catalog/original-expansion-wm-29-hill-farmer
 {:triggers [{:event :fence :effect {:op :gain :goods {:food [:if [:= [:rooms] 2] 2 [:if [:= [:rooms] 3] 1 0]]}}}
             {:event :plow :effect {:op :gain :goods {:food [:if [:= [:rooms] 2] 2 [:if [:= [:rooms] 3] 1 0]]}}}]}
 :catalog/original-expansion-wm-38-minimalist
 {:score {:type :expression :value [:if [:= [:improvements] 0] 9 [:if [:= [:improvements] 1] 6 [:if [:= [:improvements] 2] 4 [:if [:= [:improvements] 3] 2 0]]]]}}
 :catalog/original-expansion-wm-41-politician
 {:play [{:op :gain :goods {:stone 1}}]
  :ability {:op :exchange-options :limit-per-round 2
            :options [{:label "1 reed → 1 stone" :cost {:reed 1} :goods {:stone 1}}
                      {:label "1 stone → 1 reed" :cost {:stone 1} :goods {:reed 1}}]}}
 :catalog/original-expansion-wm-51-tavern-keeper
 {:triggers [{:event :before-field-phase
              :condition [:test [:and [:not [:= [:context :manure?] true]] [:> [:rooms] [:family]]]]
              :effect {:op :gain :goods {:food 1 :grain 1}}}]
  :score {:type :expression :value [:max 0 [:- [:rooms] [:family]]]}}
 :catalog/original-expansion-wm-92-keys
 {:passive {:share-action-spaces #{:build}}}
 :catalog/original-expansion-wm-93-kindling
 {:passive {:major-as-minor #{:fireplace-2 :fireplace-3 :hearth-4 :hearth-5}
            :specific-improvement-discounts {:fireplace-2 {:clay 1} :fireplace-3 {:clay 1} :hearth-4 {:clay 1} :hearth-5 {:clay 1}}}}
 :catalog/original-expansion-wm-101-prize-winning-sheep
 {:play [{:op :choose-good :choices [:wood :clay :reed :stone]}]}

 :catalog/original-expansion-wm-15-debris-dealer
 {:triggers [{:event :renovate :condition [:test [:= [:context :previous-house] :clay]]
              :effect {:op :gain :goods {:clay 2}}}
             {:event :renovate :scope :others :condition [:test [:not [:= [:house] :wood]]]
              :effect {:op :gain :goods {:wood [:if [:= [:context :previous-house] :wood] 2 0]
                                        :clay [:if [:= [:context :previous-house] :clay] 2 0]}}}]}
 :catalog/original-expansion-wm-28-herdsman
 {:triggers [{:event :use-space :spaces #{:labor} :condition [:test [:< [:round] 6]]
              :effect {:op :gain :goods {:sheep 1}}}
             {:event :use-space :spaces #{:labor} :condition [:test [:>= [:round] 6]]
              :effect {:op :choose-good :choices [:sheep :boar]}}]}
 :catalog/original-expansion-wm-106-ruins
 {:play [{:op :stock :goods [:stone :stone :stone :stone]}]
  :triggers [{:event :field-phase :condition [:test [:not [:= [:context :manure?] true]]]
              :effect {:op :take-stock :optional? true}}]}
 :catalog/original-expansion-wm-108-steamer
 {:ability {:op :exchange-options :food-conversion? true :exclude-phases #{:breeding} :exclude-final-breeding? true
            :options [{:label "1 grain + 1 vegetable → 5 food" :cost {:grain 1 :vegetable 1} :goods {:food 5}}
                      {:label "1 grain + 1 sheep → 4 food" :cost {:grain 1 :sheep 1} :goods {:food 4}}
                      {:label "1 grain + 1 boar → 5 food" :cost {:grain 1 :boar 1} :goods {:food 5}}
                      {:label "1 grain + 1 cattle → 6 food" :cost {:grain 1 :cattle 1} :goods {:food 6}}]}}
 :catalog/original-expansion-wm-73-diamond-mine
 {:play [{:op :schedule :offsets [1 2] :goods {:stone 1}}]}
 :catalog/original-expansion-wm-77-edible-roots
 {:passive {:observe-empty-harvest true}
  :triggers [{:event :harvest-crop :condition [:test [:= [:context :emptied-field?] true]]
              :effect {:op :gain :goods {:food 1}}}]}
 :catalog/original-expansion-wm-79-festival-hall
 {:requires [:>= [:grain-fields] 2]
  :triggers [{:event :after-field-phase :condition [:test [:and [:not [:= [:context :manure?] true]] [:> [:goods :grain] 0]]]
              :effect {:op :choose :optional? true
                       :options [{:label "Grain → Wood + Food" :cost {:grain 1} :effects [{:op :gain :goods {:wood 1 :food 2}}]}
                                 {:label "Grain → Clay + Food" :cost {:grain 1} :effects [{:op :gain :goods {:clay 1 :food 2}}]}
                                 {:label "Grain → Reed + Food" :cost {:grain 1} :effects [{:op :gain :goods {:reed 1 :food 2}}]}
                                 {:label "Grain → Stone + Food" :cost {:grain 1} :effects [{:op :gain :goods {:stone 1 :food 2}}]}]}}]}

 :catalog/original-expansion-wm-22-food-connoisseur
 {:play [{:op :stock :goods [:clay :vegetable :stone :grain :wood :reed]}]
  :triggers [{:event :use-space :spaces #{:labor :fishing :traveling}
              :condition [:test [:> [:source-goods :food] 0]]
              :effect {:op :take-stock}}]}
 :catalog/original-expansion-wm-96-oak-cask
 {:play [{:op :store-goods :goods {:food 1}}]
  :triggers [{:event :field-phase
              :condition [:test [:and [:not [:= [:context :manure?] true]]
                                      [:> [:stored-good :catalog/original-expansion-wm-96-oak-cask :food] 0]]]
              :effect {:op :store-goods :goods {:food 1}}}]
  :ability {:op :release-stored}}

 :catalog/original-expansion-wm-88-grain-elevator
 {:triggers [{:event :round-start
              :condition [:test [:< [:stored-good :catalog/original-expansion-wm-88-grain-elevator :grain] [:player-count]]]
              :effect {:op :store-goods :goods {:grain 1}}}
             {:event :use-space :spaces #{:grain} :effect {:op :release-stored}}
             {:event :use-space :scope :others :spaces #{:grain} :effect {:op :clear-stored}}]}
 :catalog/original-expansion-wm-78-farm-school
 {:passive {:observe-harvest-count true}
  :triggers [{:event :harvest-crops
              :condition [:test [:and [:not [:= [:context :manure?] true]] [:>= [:context :harvested-goods] 2]]]
              :effect {:op :card-action :kinds #{:occupation} :occupation-cost 2 :optional? true}}]}

 :catalog/original-expansion-wm-1-amazon
 {:triggers [{:event :use-space :spaces #{:fishing} :condition [:round 7] :effect {:op :gain :goods {:sheep 1}}}
             {:event :use-space :spaces #{:fishing} :condition [:round 9] :effect {:op :gain :goods {:boar 1}}}
             {:event :use-space :spaces #{:fishing} :condition [:round 11] :effect {:op :gain :goods {:cattle 1}}}
             {:event :use-space :spaces #{:fishing} :condition [:round 13]
              :effect {:op :choose-good :choices [:sheep :boar :cattle]}}]}
 :catalog/original-expansion-wm-59-apprenticeship
 {:play [{:op :card-action :kinds #{:occupation} :occupation-cost 0 :optional? true
          :available-when [:fewer-occupations-than-each-other]}]}

}
