 :regressions
 [{:id :lodger-person-supply-and-choice
   :cards [:catalog/revised-artifex-expansion-a-127-lodger]
   :source "https://docs.google.com/document/d/1WUl0HlzX6Yx0ume75UmpaIMhoHukx9XufM_LbV1oZ6E/edit"
   :authority :unofficial-compilation
   :rule "Lodger expires at returning home in round nine; a person removed for lacking other accommodation can never grow back."
   :implementation-assumption "Without a card-specific ruling about room assignment, a player with both adult and newborn people chooses which occupied the temporary room. The saved mandatory choice updates newborn feeding and permanently reduces person supply."
   :test agricola.artifex-temporary-test/lodger-saves-a-choice-between-an-adult-and-newborn-occupant}
  {:id :stable-planner-supply-reservations
   :cards [:catalog/revised-artifex-expansion-a-89-stable-planner]
   :source "https://docs.google.com/document/d/1WUl0HlzX6Yx0ume75UmpaIMhoHukx9XufM_LbV1oZ6E/edit"
   :authority :unofficial-compilation
   :rule "Stable Planner reserves physical stable pieces; they cannot be built early, and their preparation-phase construction does not trigger own-turn stable bonuses."
   :test agricola.artifex-temporary-test/stable-planner-reserves-physical-pieces-until-their-rounds}
  {:id :woolgrower-completed-feeding
   :cards [:catalog/revised-artifex-expansion-a-148-woolgrower]
   :source "https://docs.google.com/document/d/1WUl0HlzX6Yx0ume75UmpaIMhoHukx9XufM_LbV1oZ6E/edit"
   :authority :unofficial-compilation
   :rule "Woolgrower counts completed shared feeding phases, including those before it was played; the new sheep space is available for the following breeding phase."
   :test agricola.woolgrower-test/woolgrower-new-capacity-is-usable-during-the-same-harvest}
  {:id :baking-sheet-requires-normal-baking
   :cards [:catalog/revised-artifex-expansion-a-30-baking-sheet]
   :source "https://docs.google.com/document/d/1WUl0HlzX6Yx0ume75UmpaIMhoHukx9XufM_LbV1oZ6E/edit"
   :authority :unofficial-compilation
   :rule "Baking Sheet permits one optional extra grain exchange after normal baking; it cannot supply the required baking itself."
   :test agricola.baking-sheet-test/baking-sheet-triggers-once-per-bake-and-after-an-ovens-granted-bake}
  {:id :construction-family-growth-once
   :cards [:catalog/revised-artifex-expansion-a-21-family-friend-home :catalog/revised-artifex-expansion-a-93-bed-maker]
   :source "https://docs.google.com/document/d/1WUl0HlzX6Yx0ume75UmpaIMhoHukx9XufM_LbV1oZ6E/edit"
   :authority :unofficial-compilation
   :rule "Family Friend Home and Bed Maker each offer one family growth action per room-building action, regardless of room count. Family Friend Home requires spare rooms before construction."
   :test agricola.artifex-construction-test/bed-maker-is-one-paid-growth-per-room-action}
  {:id :work-certificate-immediate-use :cards [:catalog/revised-artifex-expansion-a-82-work-certificate]
   :source "https://docs.google.com/document/d/1WUl0HlzX6Yx0ume75UmpaIMhoHukx9XufM_LbV1oZ6E/edit"
   :authority :unofficial-compilation
   :rule "Work Certificate may trigger on the action used to play it. The specific card entry and 2022 revision supersede the compendium's older generic timing example."
   :test agricola.artifex-board-test/work-certificate-triggers-on-its-own-play-and-on-card-spaces}
  {:id :limited-sowing-is-not-unconditional :cards [:catalog/revised-artifex-expansion-a-65-seed-pellets :catalog/revised-artifex-expansion-a-79-garden-hoe :catalog/revised-artifex-expansion-a-115-chief-forester]
   :source "https://www.lookout-spiele.de/upload/de_agricolare.html_Appendix_Agricola-RE_EN.pdf"
   :authority :publisher :page 5
   :rule "A Sow action restricted to one field is not unconditional and does not activate effects that require unconditional sowing."
   :test agricola.sowing-cards-test/chief-forester-is-one-field-and-not-unconditional-even-on-riverbank}
  {:id :field-cards-scoring :cards [:revised-base/b068]
   :source "https://www.lookout-spiele.de/upload/de_agricolare.html_Appendix_Agricola-RE_EN.pdf"
   :authority :publisher :page 11
   :rule "Only farmyard field tiles earn field-tile points. Crops on field cards still contribute to crop scoring."
   :test agricola.engine-test/field-cards-score-crops-but-not-field-tile-points}
  {:id :fields-and-field-tiles :cards [:revised-base/b068 :catalog/revised-artifex-expansion-a-70-lifting-machine :catalog/revised-artifex-expansion-a-72-calcium-fertilizers]
   :source "https://www.lookout-spiele.de/upload/de_agricolare.html_Appendix_Agricola-RE_EN.pdf"
   :authority :publisher :page 3
   :rule "Field prerequisites include cards that identify themselves as fields. Field-tile prerequisites count only tiles on the farmyard board."
   :test agricola.artifex-crop-test/field-card-prerequisites-distinguish-fields-from-field-tiles}
  {:id :winnowing-fan-after-field-phase :cards [:catalog/revised-artifex-expansion-a-61-winnowing-fan :revised-base/a112]
   :source "https://docs.google.com/document/d/1WUl0HlzX6Yx0ume75UmpaIMhoHukx9XufM_LbV1oZ6E/edit"
   :authority :unofficial-compilation
