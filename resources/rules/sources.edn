   :test agricola.artifex-crop-test/winnowing-fan-waits-for-the-end-of-the-field-phase}
  {:id :wood-worker-funds-cultivator :cards [:catalog/revised-artifex-expansion-a-164-wood-worker :catalog/revised-artifex-expansion-a-91-shifting-cultivator]
   :source "https://docs.google.com/document/d/1WUl0HlzX6Yx0ume75UmpaIMhoHukx9XufM_LbV1oZ6E/edit"
   :authority :unofficial-compilation
   :rule "Wood Worker resolves during use; its sheep may be cooked to fund Shifting Cultivator. Basket and Mushroom Collector resolve later."
   :test agricola.artifex-interactions-test/wood-worker-can-fund-shifting-cultivator-with-cooked-sheep}
  {:id :wooden-shed-major-action :cards [:catalog/revised-artifex-expansion-a-10-wooden-shed]
