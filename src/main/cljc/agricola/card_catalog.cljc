   {:id "original-expansion-nl-67-schoolmaster" :edition "Original" :pack "Expansion" :deck "NL" :number "67" :type "Occupation" :name "Schoolmaster" :min-players 4 :cost-text "" :prerequisites "" :points-text "" :passing? false :text "Whenever another player uses a \"Family growth\" action, they must first pay you 1/2 Food if they have 2-5/6+ Food markers in their personal supply." :printed-cost {}}
