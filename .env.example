# Copy to .env and fill in values from https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# A stable random secret (at least 32 bytes), separate from Discord credentials.
EUROZONE_SESSION_SECRET=
# Your public HTTPS origin, without a trailing slash.
EUROZONE_PUBLIC_URL=
HOST=127.0.0.1
PORT=3002
EUROZONE_DATA=data/discord-eurozone.edn
# Optional RTCConfiguration JSON. Production TURN credentials should be short lived.
EUROZONE_RTC_CONFIG=

# Private by default: list your own Discord user ID and each invited friend.
EUROZONE_PRIVATE=true
DISCORD_ALLOWED_USER_IDS=
